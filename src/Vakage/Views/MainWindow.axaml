<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="clr-namespace:Vakage.Design"
        x:Class="Vakage.Views.MainWindow"
        Title="Vakage"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Vakage/Assets/app.ico">

  <Border Classes="page">
    <DockPanel LastChildFill="True">

      <!-- Whose archive, and bringing exports in. -->
      <Border Classes="section bar" DockPanel.Dock="Top" Margin="12,12,12,0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button Classes="pill indigo active" x:Name="ConversationsTab" Click="OnConversationsTabClick">
              <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Comments}" Text="Conversations" Hue="indigo" />
            </Button>
            <Button Classes="pill amber" x:Name="FilesTab" Click="OnFilesTabClick">
              <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Paperclip}" Text="Files" Hue="amber" />
            </Button>
            <Button Classes="pill amber" Click="OnLibraryFolderClick" ToolTip.Tip="Open the library folder">
              <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.BoxArchive}" Hue="amber" />
            </Button>
          </StackPanel>
          <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Classes="title" Text="Vakage" VerticalAlignment="Center" Margin="4,0,20,0" />
            <TextBlock Classes="caption" Text="Account" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="AccountBox" MinWidth="180" VerticalAlignment="Center" SelectionChanged="OnAccountChanged" Margin="0,4,8,4" />
            <Button Classes="pill lime" Click="OnNewAccountClick" Margin="0,4,8,4" ToolTip.Tip="New account: a person whose phone exports come from">
              <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.UserPlus}" Hue="lime" />
            </Button>
            <Button Classes="pill lime" x:Name="ImportFileButton" Click="OnImportFileClick" Margin="0,4,8,4" ToolTip.Tip="Import one or more exported chats (.zip or .txt) into this account">
              <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.FileImport}" Text="Import" Hue="lime" />
            </Button>
            <Button Classes="pill lime" x:Name="ImportFolderButton" Click="OnImportFolderClick" Margin="0,4,0,4" ToolTip.Tip="Import an export that was already unzipped into a folder">
              <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.FolderOpen}" Text="Import folder" Hue="lime" />
            </Button>
          </WrapPanel>
        </DockPanel>
      </Border>

      <Border Classes="section" DockPanel.Dock="Bottom" Margin="12">
        <SelectableTextBlock Classes="caption" x:Name="StatusLine" TextWrapping="Wrap" />
      </Border>

      <Panel Margin="12,12,12,0">

        <!-- Conversations: the list, and the stream of the one chosen. -->
        <Grid x:Name="ConversationsPanel" ColumnDefinitions="380,12,*">
          <Border Classes="section" Grid.Column="0" Padding="0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8" Spacing="2">
                <TextBlock Classes="heading" Text="Conversations" />
                <TextBlock Classes="caption" x:Name="ConversationsCaption" TextWrapping="Wrap" />
              </StackPanel>
              <ListBox x:Name="ConversationList" SelectionMode="Multiple" Margin="8,0,8,8"
                       SelectionChanged="OnConversationSelectionChanged" />
            </DockPanel>
          </Border>

          <Border Classes="section" Grid.Column="2" Padding="0">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,16,16,4">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="heading" x:Name="ChatTitle" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" x:Name="ChatCaption" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                  <Button Classes="pill blue" x:Name="JoinButton" Click="OnJoinClick" IsVisible="False"
                          ToolTip.Tip="These chats are one person: each history stays apart, and can be read alone or all together">
                    <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Link}" Text="Same person" Hue="blue" />
                  </Button>
                  <Button Classes="pill indigo" x:Name="CalendarButton" Click="OnCalendarClick" IsEnabled="False"
                          ToolTip.Tip="A calendar of this conversation: each day coloured by how much was said; click a day to go to it">
                    <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.CalendarDays}" Text="Calendar" Hue="indigo" />
                  </Button>
                  <Button Classes="pill amber" x:Name="MediaButton" Click="OnMediaClick" IsEnabled="False"
                          ToolTip.Tip="Every file exchanged in this conversation: pictures, videos, audio, documents">
                    <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Paperclip}" Text="Media" Hue="amber" />
                  </Button>
                  <Button Classes="pill slate" x:Name="SettingsButton" Click="OnChatSettingsClick" IsEnabled="False"
                          ToolTip.Tip="This conversation's settings: noisy, separate, delete">
                    <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Gear}" Hue="slate" />
                  </Button>
                </StackPanel>
              </Grid>
              <!-- One person's chat histories: all together, or each alone. -->
              <WrapPanel x:Name="HistoryBar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,0,16,4" />
              <!-- What can be done with the messages picked in the stream. -->
              <Border x:Name="SelectionBar" DockPanel.Dock="Top" Classes="section bar" Margin="12,0,12,8" IsVisible="False">
                <WrapPanel Orientation="Horizontal">
                  <TextBlock x:Name="SelectionCaption" Classes="caption" VerticalAlignment="Center" Margin="4,0,12,0" />
                  <Button Classes="pill lime" Click="OnMessagesMarkClick" Tag="important" Margin="0,2,8,2"
                          ToolTip.Tip="Mark the media of these messages important: kept whole, never reduced">
                    <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Star}" Text="Important" Hue="lime" />
                  </Button>
                  <Button Classes="pill orange" Click="OnMessagesMarkClick" Tag="irrelevant" Margin="0,2,8,2"
                          ToolTip.Tip="Mark the media of these messages irrelevant">
                    <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Ban}" Text="Irrelevant" Hue="orange" />
                  </Button>
                  <Button Classes="pill orange" Click="OnMessagesCompressClick" Margin="0,2,8,2"
                          ToolTip.Tip="Keep a small version of their media: documents become text, pictures a thumbnail (or their words), videos a picture of the first frame">
                    <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Compress}" Text="Compress" Hue="orange" />
                  </Button>
                  <Button Classes="pill orange" Click="OnMessagesDeleteMediaClick" Margin="0,2,8,2"
                          ToolTip.Tip="Delete only their media; the messages stay, with a notice">
                    <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Eraser}" Text="Delete media" Hue="orange" />
                  </Button>
                  <Button Classes="pill orange" Click="OnMessagesDeleteClick" Margin="0,2,8,2"
                          ToolTip.Tip="Delete these messages completely, with their media">
                    <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.TrashCan}" Text="Delete" Hue="orange" />
                  </Button>
                  <Button Classes="pill slate" Click="OnClearSelectionClick" Margin="0,2,0,2" ToolTip.Tip="Unselect them all">
                    <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Xmark}" Hue="slate" />
                  </Button>
                </WrapPanel>
              </Border>
              <ListBox x:Name="MessageList" Margin="8,0,8,8" SelectionMode="Multiple,Toggle" SelectionChanged="OnMessageSelectionChanged" />
            </DockPanel>
          </Border>
        </Grid>

        <!-- Files: every stored file of the account, on its list (important,
             irrelevant, unsorted), largest first. -->
        <Border x:Name="FilesPanel" Classes="section" Padding="0" IsVisible="False">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,16,16,8">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="heading" Text="Files" />
                <TextBlock Classes="caption" x:Name="FilesCaption" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="pill lime" x:Name="ImportantTab" Click="OnFileListClick" Tag="Important"
                        ToolTip.Tip="Show only the important files: the precious ones, kept whole">
                  <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Star}" Text="Important" Hue="lime" />
                </Button>
                <Button Classes="pill orange" x:Name="IrrelevantTab" Click="OnFileListClick" Tag="Irrelevant"
                        ToolTip.Tip="Show the irrelevant files: noise to reduce to a thumbnail or its text">
                  <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Ban}" Text="Irrelevant" Hue="orange" />
                </Button>
                <Button Classes="pill amber" x:Name="DocumentsTab" Click="OnFileListClick" Tag="Documents"
                        ToolTip.Tip="Show the documents: PDFs, and pictures whose words read as a receipt, a ticket, an ID, a contract…">
                  <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.FileLines}" Text="Documents" Hue="amber" />
                </Button>
                <Button Classes="pill amber" x:Name="UnsortedTab" Click="OnFileListClick" Tag="Unsorted"
                        ToolTip.Tip="Show the files on neither list yet">
                  <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Paperclip}" Text="Unsorted" Hue="amber" />
                </Button>
                <Button Classes="pill amber active" x:Name="AllFilesTab" Click="OnFileListClick" Tag="All">
                  <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.BoxArchive}" Text="All" Hue="amber" />
                </Button>
              </StackPanel>
            </Grid>
            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,0,16,8">
              <ComboBox x:Name="WithBox" MinWidth="220" SelectionChanged="OnFilesFilterChanged" Margin="0,4,8,4"
                        ToolTip.Tip="Files exchanged with one person (all their chat histories) or in one group" />
              <ComboBox x:Name="TypeBox" MinWidth="140" SelectionChanged="OnFilesFilterChanged" Margin="0,4,16,4" />
              <ComboBox x:Name="SenderModeBox" MinWidth="150" SelectionChanged="OnFilesFilterChanged" Margin="0,4,8,4" />
              <ComboBox x:Name="SenderBox" MinWidth="220" SelectionChanged="OnFilesFilterChanged" Margin="0,4,16,4" />
              <Button Classes="pill lime" x:Name="MarkImportantButton" Click="OnMarkClick" Tag="important" IsEnabled="False" Margin="0,4,8,4"
                      ToolTip.Tip="Mark the selected files important: kept whole, never reduced, never deleted with a chat">
                <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Star}" Text="Mark important" Hue="lime" />
              </Button>
              <Button Classes="pill orange" x:Name="MarkIrrelevantButton" Click="OnMarkClick" Tag="irrelevant" IsEnabled="False" Margin="0,4,8,4"
                      ToolTip.Tip="Mark the selected files irrelevant">
                <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Ban}" Text="Mark irrelevant" Hue="orange" />
              </Button>
              <Button Classes="pill slate" x:Name="ClearMarkButton" Click="OnMarkClick" Tag="" IsEnabled="False" Margin="0,4,8,4"
                      ToolTip.Tip="Take your mark off: the file goes back to what Vakage suggests">
                <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Eraser}" Text="Clear mark" Hue="slate" />
              </Button>
              <Button Classes="pill amber" x:Name="OpenFileButton" Click="OnOpenFileClick" IsEnabled="False" Margin="0,4,8,4">
                <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.FolderOpen}" Text="Open" Hue="amber" />
              </Button>
              <Button Classes="pill orange" x:Name="ReduceButton" Click="OnReduceClick" IsVisible="False" Margin="8,4,0,4"
                      ToolTip.Tip="Keep only the text or a thumbnail of the irrelevant files (the selected ones, or all on this list) and delete the originals">
                <design:ActionIconLabel Glyph="{x:Static design:ActionIcons.Compress}" Text="Reduce" Hue="orange" />
              </Button>
            </WrapPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="64,96,*,260,180,220,96" Margin="24,0,24,4">
              <TextBlock Grid.Column="1" Classes="columnheader" Text="Size" />
              <TextBlock Grid.Column="2" Classes="columnheader" Text="File" />
              <TextBlock Grid.Column="3" Classes="columnheader" Text="Standing" />
              <TextBlock Grid.Column="4" Classes="columnheader" Text="Sent by" />
              <TextBlock Grid.Column="5" Classes="columnheader" Text="In" />
              <TextBlock Grid.Column="6" Classes="columnheader" Text="First sent" />
            </Grid>
            <ListBox x:Name="FileList" Margin="8,0,8,8" SelectionMode="Multiple"
                     SelectionChanged="OnFileSelectionChanged" DoubleTapped="OnFileDoubleTapped" />
          </DockPanel>
        </Border>

      </Panel>
    </DockPanel>
  </Border>
</Window>
