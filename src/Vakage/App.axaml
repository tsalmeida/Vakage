<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vakage.App"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the OS light/dark preference. Stone is Vakage's
       identity hue and belongs to the icon alone. -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Vakage/Design/Design.axaml" />
  </Application.Styles>
</Application>
